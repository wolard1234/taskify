BOT_TOKEN=your_telegram_bot_token_here
# BOT_USERNAME=your_telegram_bot_username
FLASK_SECRET=change-this-to-a-random-string
ADMIN_TOKEN=your-secret-admin-password
# Telegram user IDs with the bot administrator role, separated by commas.
# ADMIN_TELEGRAM_IDS=123456789,987654321
WEB_URL=http://localhost:5000
FLASK_DEBUG=false
PORT=5000
DIGEST_HOUR=9
# Allow local sign-in at /dev-login in Docker Compose.
# TASKIFY_DEV_LOGIN=true
